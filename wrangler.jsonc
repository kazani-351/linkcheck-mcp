{
  "name": "linkcheck-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Required by the `agents` package (imports node:async_hooks) and by our own
  // punycode/IDN decoding in heuristics.ts (node:url domainToUnicode).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "FEEDS_DB",
      "database_name": "linkcheck-mcp-feeds",
      "database_id": "233ab177-47aa-425e-a03c-39a459363d72"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VERDICT_CACHE",
      "id": "a71b21666a734eee85f4ceb8a9ed508c"
    }
  ],
  // Daily refresh (SPEC §6/§9/§18 — "daily assumed", may tighten later if
  // budget allows). 06:17 UTC — off the hour/half-hour to avoid piling onto
  // everyone else's midnight/top-of-hour cron load.
  "triggers": {
    "crons": ["17 6 * * *"]
  }
}
