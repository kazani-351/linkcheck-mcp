{
  // Slice 2: bare MCP integration. D1/KV/Cron bindings added in later slices.
  "name": "linkcheck-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Required by the `agents` package (imports node:async_hooks) and by our own
  // punycode/IDN decoding in heuristics.ts (node:url domainToUnicode).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
}
